    "version": "0.2.0",
    "configurations": [
        {
            "name": "Relay.Api",
            "type": "dotnet",
            "request": "launch",
            "projectPath": "${workspaceFolder}/src/Relay.Api/Relay.Api.csproj",
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+http://\\S+:([0-9]+)",
                "uriFormat": "http://localhost:%s/openapi/v1.json"
            }
        }
    ]
}